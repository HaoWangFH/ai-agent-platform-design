<Project>
  <!-- 
    AI-EOS Automation:
    This file automatically links all architecture and specification markdown files 
    into the C# projects. This ensures that Visual Studio 2026 and GitHub Copilot Chat 
    can always see the latest specifications without any manual updates to the .sln file.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\07-Architecture\**\*.md" Link="AI-EOS-Docs\07-Architecture\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)..\..\08-Specification-Driven-Development\**\*.md" Link="AI-EOS-Docs\08-Specification-Driven-Development\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(MSBuildThisFileDirectory)..\..\.agyrules" Link="AI-EOS-Docs\.agyrules" />
    <None Include="$(MSBuildThisFileDirectory)..\..\.github\copilot-instructions.md" Link="AI-EOS-Docs\copilot-instructions.md" />
  </ItemGroup>
</Project>
