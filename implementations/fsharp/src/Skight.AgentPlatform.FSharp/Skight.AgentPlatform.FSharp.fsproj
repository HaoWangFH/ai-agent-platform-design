<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Skight.AgentPlatform.FSharp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ToolSecurity.fs" />
    <Compile Include="ApprovalGuard.fs" />
    <Compile Include="FileTools.fs" />
    <Compile Include="TerminalTool.fs" />
    <Compile Include="GitTools.fs" />
    <Compile Include="WebTools.fs" />
    <Compile Include="MemoryStore.fs" />
    <Compile Include="MemoryTool.fs" />
    <Compile Include="TodoTool.fs" />
    <Compile Include="SystemInfoTool.fs" />
    <Compile Include="MediaTools.fs" />
    <Compile Include="IntegrationTools.fs" />
    <Compile Include="AutomationTools.fs" />
    <Compile Include="ToolRegistry.fs" />
    <Compile Include="McpProtocol.fs" />
    <Compile Include="McpSchemaTranslator.fs" />
    <Compile Include="McpClient.fs" />
    <Compile Include="McpRegistryExtensions.fs" />
    <Compile Include="AgentSession.fs" />
    <Compile Include="SdkAdapter.fs" />
    <Compile Include="Telemetry.fs" />
    <Compile Include="ContextCompressor.fs" />
    <Compile Include="AgentPipeline.fs" />
    <Compile Include="AgentRunner.fs" />
    <Compile Include="ClarifyTool.fs" />
    <Compile Include="DelegateTool.fs" />
    <Compile Include="Agent.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="1.0.0-beta.17" />
    <PackageReference Include="FSharp.Control.TaskSeq" Version="1.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

</Project>
